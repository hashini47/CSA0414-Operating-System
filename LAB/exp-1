#include &lt;stdio.h&gt;
#include &lt;fcntl.h&gt;
#include &lt;unistd.h&gt;
int main()
{
int f1, f2;
char ch;
f1 = open(&quot;source.txt&quot;, O_RDONLY);
f2 = open(&quot;destination.txt&quot;, O_WRONLY | O_CREAT | O_TRUNC, 0644);
while (read(f1, &amp;ch, 1))
{
write(f2, &amp;ch, 1);
}
close(f1);
close(f2);
printf(&quot;File copied successfully&quot;);
return 0;
}
